# =====================================================================
# Amazon Affiliate CA — Variables d'environnement
# Copier ce fichier en `.env` puis remplir les valeurs REELLES.
# NE JAMAIS mettre de fausses valeurs. Si une valeur manque, le
# pipeline reste en mode local / fichier et NE publie rien.
# =====================================================================

# --- Google Sheet (source de verite) --------------------------------
# Identifiant du Google Sheet "Amazon Affiliate Product Database"
# (visible dans l'URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=

# Chemin vers le fichier JSON du service account Google Cloud
# (ou contenu JSON inline entre guillemets)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Nom de la feuille (onglet) contenant les produits
GOOGLE_SHEET_TAB=Products

# --- Site -----------------------------------------------------------
# URL publique du site (canonical, sitemap, structured data).
# Exemple: https://monsite.ca
SITE_URL=

# Langue par defaut (fr-CA)
SITE_LANG=fr-CA

# Nom public du site (affiche dans les pages a-propos / divulgation)
SITE_NAME=

# --- Publication ----------------------------------------------------
# Gate de qualite minimale pour publication automatique (0-100)
MIN_QUALITY_SCORE=90

# Publication automatique: false = tout passe en DRAFT/REVIEW
AUTO_PUBLISH=false